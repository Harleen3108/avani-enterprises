# Master Gitignore
node_modules/
dist/
build/
.env*
# ...but the template must be committed — it is the only checked-in record of
# which variables a deploy needs. It contains names and comments, never values.
!**/.env.example
!.env.example
*.log
.vscode/
.DS_Store
*.mp4
!avani-connect-glow-main/public/avanivideo.mp4
# Scroll-cinema footage for /avanihome. These are page content, not stray
# exports — the route renders nothing without them, so they have to ship.
!avani-connect-glow-main/public/avanihome/*.mp4
