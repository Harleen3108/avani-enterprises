# =============================================================================
# Avani Enterprises — backend environment
# =============================================================================
# Copy to `.env` and fill in. `.env` is gitignored and must NEVER be committed.
# On Render these same keys go in Dashboard → your service → Environment.
#
# Nothing here may be prefixed NEXT_PUBLIC_ / VITE_. Every value below is a
# server-side secret or server-side configuration; none of it is safe in a
# browser bundle.
# =============================================================================


# ─────────────────────────────────────────────────────────────────────────────
# Core (already in use — listed so a fresh clone can boot)
# ─────────────────────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development
MONGO_URI=
JWT_SECRET=

# Cloudinary — already used for newsletter images and CV uploads, and reused by
# the WhatsApp catalogue upload. No second storage provider is needed.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email / leads
SENDGRID_API_KEY=
BREVO_API_KEY=
FROM_EMAIL=
FROM_NAME=
LEAD_NOTIFY_EMAILS=
ADMIN_EMAIL=
ADMIN_LOGIN_CODE=

# Analytics / SEO
IP_HASH_SALT=
FRONTEND_URL=
PUBLIC_SITE_URL=https://www.avanienterprises.in
SITE_URL=https://www.avanienterprises.in
SITE_HOST=www.avanienterprises.in


# =============================================================================
# WHATSAPP AUTOMATION
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# Meta WhatsApp Cloud API
# ─────────────────────────────────────────────────────────────────────────────
# From the NEW Meta app created for WhatsApp automation, using the TEST
# WhatsApp Business Account and test number.
#
# ⚠️ Do NOT use the credentials of the existing production WhatsApp Business
# Account, and do NOT use the Social CRM / social-posting Meta app. This
# integration is scoped to the new test app only.

# Meta app → WhatsApp → API Setup → temporary access token (24 h) for local
# testing. For Render, generate a permanent System User token instead:
# Business Settings → System Users → Generate token, with the
# whatsapp_business_messaging and whatsapp_business_management permissions.
WHATSAPP_ACCESS_TOKEN=

# Meta app → WhatsApp → API Setup → "Phone number ID" (a long number, NOT the
# phone number itself).
WHATSAPP_PHONE_NUMBER_ID=

# Same screen → "WhatsApp Business Account ID".
WHATSAPP_BUSINESS_ACCOUNT_ID=

# A string YOU invent. Paste the identical value into Meta's webhook
# configuration ("Verify token"). Meta echoes it back during the GET handshake
# and the webhook returns 403 unless it matches. Use something random:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
WHATSAPP_VERIFY_TOKEN=

# Meta app → Settings → Basic → App Secret.
# OPTIONAL but strongly recommended. When set, every webhook POST must carry a
# valid X-Hub-Signature-256 or it is rejected with 401 — that is what stops
# anyone who learns the URL from injecting fake messages. Leave blank while
# first wiring things up, then set it.
META_APP_SECRET=

# Graph API version. v23.0 is the floor that supports the WhatsApp Business
# Calling API. Raise it only when you need a newer field.
META_GRAPH_API_VERSION=v23.0


# ─────────────────────────────────────────────────────────────────────────────
# Catalogue
# ─────────────────────────────────────────────────────────────────────────────
# The PDF is NOT bundled in the application. Set a public HTTPS URL — Meta
# downloads it server-side, so it cannot sit behind authentication. Uploading a
# PDF from the admin panel (POST /admin/whatsapp/catalogue) overrides this
# without a redeploy.
CATALOGUE_PDF_URL=

# Optional. A media id already uploaded to Meta. Takes precedence over the URL
# and skips the download on every send.
CATALOGUE_MEDIA_ID=

# The filename the customer sees in WhatsApp.
CATALOGUE_FILENAME=Avani-Enterprises-Catalogue.pdf

# Hours before the same person may receive the catalogue again (168 = 1 week).
# Set 0 to send it only once, ever. An explicit "send me the catalogue" always
# overrides this.
CATALOGUE_RESEND_HOURS=168


# ─────────────────────────────────────────────────────────────────────────────
# Behaviour
# ─────────────────────────────────────────────────────────────────────────────
# Master switch. false = webhooks are still received and logged, but nothing is
# ever sent back. Useful for observing traffic before going live.
WHATSAPP_AUTOMATION_ENABLED=true

# Blue ticks on incoming messages.
WHATSAPP_MARK_AS_READ=true

# What to do with an inbound WhatsApp call:
#   reject  hang up immediately, then send the catalogue by message (default)
#   ignore  let it ring out, then send the catalogue once Meta reports it ended
# This backend has no voice/media stack, so it never answers a call.
WHATSAPP_CALL_ACTION=reject

# DEVELOPMENT SAFETY NET. While this is non-empty the backend will only ever
# send to these numbers, so a stray webhook from a real customer cannot be
# answered by a half-finished bot. Comma-separated, digits only, country code
# included. LEAVE THIS EMPTY IN PRODUCTION.
WHATSAPP_ALLOWED_NUMBERS=

# Branding used in generated copy.
BUSINESS_NAME=Avani Enterprises

# Optional. Path to a JSON file that overrides services / FAQs / copy without a
# code change. Merged over the defaults in services/whatsapp/knowledgeBase.js.
WHATSAPP_KNOWLEDGE_PATH=


# ─────────────────────────────────────────────────────────────────────────────
# AI (optional — leave as "none" and the FAQ engine answers everything)
# ─────────────────────────────────────────────────────────────────────────────
# none | anthropic | openai | gemini
AI_PROVIDER=none

# Secret key for the chosen provider. Server-side only — the browser never
# talks to the model, this backend does.
AI_API_KEY=

# Optional model override. Defaults per provider:
#   anthropic → claude-opus-5
#   openai    → gpt-4o-mini
#   gemini    → gemini-2.0-flash
AI_MODEL=

# Upper bound on a generated reply. Generous on purpose: on Claude models this
# budget covers reasoning as well as the visible text, so a tight cap truncates
# the answer. Replies are kept short by the prompt, not by this number.
AI_MAX_OUTPUT_TOKENS=2048

# Give up on the model after this long and fall back to the FAQ answer. A
# customer waiting on WhatsApp should never wait longer than this.
AI_TIMEOUT_MS=20000
